{
  "expo": {
    "name": "clean-house-app",
    "slug": "clean-house-app",
    "version": "1.0.0",
    "scheme": "cleanhouseapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kimdongjoo.cleanhouseapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "d06deb89730de080b241ef6937557224"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "내 위치로 서비스 지역을 찾기 위해 위치 정보를 사용해요."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dfb6416e-ee6d-4b70-9da5-215786ce6066"
      }
    }
  }
}
